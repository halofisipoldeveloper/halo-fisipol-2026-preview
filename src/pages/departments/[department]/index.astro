---
import Cactus from "@/components/Cactus";
import Clouds from "@/components/Clouds";
import Mountains from "@/components/Mountains";
import MountainSilhouette from "@/components/MountainSilhouette";
import Sand from "@/components/Sand";
import MainLayout from "@/layouts/MainLayout.astro";
// Pastikan komponen ini memiliki internal state (useState) di dalamnya jika menerima input
import DepartmentTextArea from "./components/_DepartmentTextArea";

// Menggabungkan data deskripsi dengan rute dan warna dari komponen parent
export const DEPARTMENTS_DATA = [
    {
        id: "dpp",
        title: "DEPARTEMEN POLITIK PEMERINTAHAN",
        color: "bg-[#F2C15A]",
        description:
            "Mengkaji kekuasaan, demokrasi, institusi politik, pemilu, hingga dinamika pemerintahan di tingkat nasional dan lokal. Cocok buat kamu yang kritis, suka mengikuti isu politik, dan ingin memahami bagaimana keputusan publik diambil.",
    },
    {
        id: "mkp",
        title: "MANAJEMEN KEBIJAKAN PUBLIK",
        color: "bg-[#9D83C4]",
        description:
            "Mempelajari bagaimana kebijakan dirancang dan dijalankan, serta bagaimana organisasi publik dikelola secara efektif. Cocok buat kamu yang ingin ikut memperbaiki layanan publik dan tata kelola pemerintahan lewat pendekatan yang terukur.",
    },
    {
        id: "hi",
        title: "HUBUNGAN INTERNASIONAL",
        color: "bg-[#E6C592]",
        description:
            "Mempelajari bagaimana negara, organisasi internasional, dan aktor global berinteraksi. Topiknya mencakup diplomasi, keamanan internasional, ekonomi politik global, hingga isu lintas negara. Cocok buat kamu yang tertarik dengan isu dunia dan cara negara bekerja sama.",
    },
    {
        id: "ilkom",
        title: "ILMU KOMUNIKASI",
        color: "bg-[#73C0B0]",
        description:
            "Mengkaji bagaimana pesan dibuat, disebarkan, dan dimaknai, mulai dari media massa, jurnalistik, public relations, hingga media digital dan budaya populer. Cocok buat kamu yang suka bercerita, kreatif, dan penasaran dengan pengaruh media di kehidupan sehari-hari.",
    },
    {
        id: "psdk",
        title: "PEMBANGUNAN SOSIAL DAN KESEJAHTERAAN",
        color: "bg-[#F5C5D1]",
        description:
            "Mempelajari berbagai pendekatan sosial dalam program pembangunan dan kesejahteraan masyarakat untuk mengatasi isu-isu sosial kontemporer secara komprehensif.",
    },
    {
        id: "sosio",
        title: "SOSIOLOGI",
        color: "bg-[#F7AE8E]",
        description:
            "Mempelajari masyarakat, bagaimana struktur sosial terbentuk, mengapa ketimpangan terjadi, dan bagaimana perubahan sosial berlangsung. Dibekali metode penelitian sosial untuk membaca fenomena di sekitar kita. Cocok buat kamu yang suka mengamati dan bertanya “kenapa masyarakat bisa begini?”.",
    },
];

export async function getStaticPaths() {
    // Membuat path dinamis berdasarkan id dari DEPARTMENTS_DATA
    return DEPARTMENTS_DATA.map((dept) => ({
        params: { department: dept.id },
    }));
}

const { department } = Astro.params;
const currentDepartment = DEPARTMENTS_DATA.find((exp) => exp.id === department);

function capitalize(text: string) {
    if (!text) return text;
    return text
        .split("-")
        .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
        .join(" ");
}
---

<MainLayout
    title={currentDepartment ? currentDepartment.title : "Tidak Ditemukan"}
>
    <section class="relative w-full h-screen overflow-hidden bg-linear-to-b from-[#71CFEB] to-[#F7E8C5]">
        <div class="relative w-full h-full animate-gate-in">
            <div class="absolute bottom-60 w-full">
                <MountainSilhouette client:load />
            </div>

            <div class="absolute top-20 w-full">
                <Clouds client:load />
            </div>

            <div class="absolute bottom-44 w-full">
                <Mountains client:load />
            </div>

            <div class="absolute bottom-0 w-full">
                <Sand />
            </div>
        </div>

        <div class="absolute inset-0 z-20 overflow-y-auto">
            <div class="min-h-full flex items-center justify-center p-6 pt-44 pb-32">
                {currentDepartment ? (
                    <div
                        class={`p-8 rounded-xl shadow-lg border-4 border-white border-dashed text-[#6D3929] max-w-2xl w-full ${currentDepartment.color}`}
                    >
                        <h1 class="text-3xl md:text-4xl font-cowboy uppercase text-center mb-6 text-white [-webkit-text-stroke:1px_#6D3929]">
                            {currentDepartment.title}
                        </h1>
                        <p class="text-lg font-medium bg-white/60 p-4 rounded-lg shadow-sm">
                            {currentDepartment.description}
                        </p>
                    </div>
                ) : (
                    <div class="bg-white p-8 rounded-xl shadow-lg text-center">
                        <h1 class="text-2xl font-bold text-red-500">
                            Departemen Tidak Ditemukan
                        </h1>
                        <p>URL tidak sesuai dengan rute yang tersedia.</p>
                    </div>
                )}
            </div>
        </div>

        <div class="absolute -bottom-5 w-full z-10">
            <Cactus client:load />
        </div>
    </section>
</MainLayout>
