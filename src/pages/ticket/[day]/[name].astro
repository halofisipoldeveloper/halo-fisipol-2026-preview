const currentRouteId = `${name}-${day}`;

const currentExperience = TICKET_EXPERIENCES.find(
    (exp) => exp.id === currentRouteId,
);
---

<MainLayout title={`${capitalize(day)} - ${capitalize(name)}`}>
    <section class="relative w-full h-screen overflow-hidden bg-linear-to-b from-[#71CFEB] to-[#F7E8C5]">
        <div class="relative w-full h-full animate-gate-in">
            <div class="absolute bottom-60 w-full">
                <MountainSilhouette client:load />
            </div>

            <div class="absolute top-20 w-full">
                <Clouds client:load />
            </div>

            <div class="absolute bottom-44 w-full">
                <Mountains client:load />
            </div>

            <div class="absolute bottom-0 w-full">
                <Sand />
            </div>
        </div>

        <div class="absolute inset-0 z-20 overflow-y-auto">
            <div class="min-h-full flex items-center justify-center p-6 pt-44 pb-32">
                {currentExperience ? (
                    <TicketCard
                        character={currentExperience.character}
                        title={currentExperience.title}
                        description={currentExperience.description}
                        isBundling={currentExperience.isBundling}
                        includes={currentExperience.includes}
                        includesDay1={currentExperience.includesDay1}
                        includesDay2={currentExperience.includesDay2}
                        bonus={currentExperience.bonus}
                    />
                ) : (
                    <div class="bg-white p-8 rounded-xl shadow-lg text-center">
                        <h1 class="text-2xl font-bold text-red-500">
                            Tiket Tidak Ditemukan
                        </h1>
                        <p>URL tidak sesuai dengan jadwal yang tersedia.</p>
                    </div>
                )}
            </div>
        </div>

        <div class="absolute -bottom-5 w-full z-10">
            <Cactus client:load />
        </div>
    </section>
</MainLayout>
