---
import { Icon } from "astro-icon/components";
import Logo from "../../public/logo.svg";
import FooterBackground from "./FooterBackground";

const iconSize = 30;
---

<section class="relative w-full overflow-hidden bg-linear-to-b from-[#8E4E28] to-[#412717] px-6 py-12 flex justify-center font-semibold">
    <div class="absolute inset-x-0 bottom-0 flex justify-center pointer-events-none z-0">
        <FooterBackground client:load />
    </div>

    <div class="relative z-10 flex flex-col md:flex-row justify-between items-start font-satoshi w-full gap-8 max-w-5xl">
        <div class="w-full md:w-1/3 flex flex-col justify-start items-start gap-y-4">
            <div class="w-28 md:w-36">
                <Logo />
            </div>
            <p class="text-white text-sm tracking-widest">
                An Open House Event of FISIPOL UGM
            </p>
        </div>

        <div class="flex flex-col text-white text-lg gap-y-4 tracking-widest">
            <div>
                <a href="/ticket" class="hover:underline">
                    Tiket
                </a>
            </div>
            <div>
                <a href="/rundown" class="hover:underline">
                    Rundown
                </a>
            </div>
            <div>
                <a href="/gallery" class="hover:underline">
                    Galeri
                </a>
            </div>
            <div>
                <a href="/faq" class="hover:underline">
                    FAQ
                </a>
            </div>
        </div>

        <div class="flex flex-col w-full md:w-auto gap-y-4">
            <p class="text-white text-xl tracking-widest">Stay in The Loop</p>
            <div class="w-full flex gap-x-6 text-white">
                <a
                    href="https://www.instagram.com/halofisipol/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-block transition-transform duration-300 hover:-translate-y-2 hover:-rotate-[20deg]"
                >
                    <Icon name="instagram" size={iconSize} />
                </a>

                <a
                    href="https://www.tiktok.com/@halofisipol?is_from_webapp=1&sender_device=pc"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-block transition-transform duration-300 hover:-translate-y-2 hover:-rotate-[20deg]"
                >
                    <Icon name="tiktok" size={iconSize} />
                </a>

                <a
                    href="https://www.linkedin.com/company/halofisipol"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-block transition-transform duration-300 hover:-translate-y-2 hover:-rotate-[20deg]"
                >
                    <Icon name="linkedin" size={iconSize} />
                </a>

                <a
                    href="https://x.com/halofisipolugm"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-block transition-transform duration-300 hover:-translate-y-2 hover:-rotate-[20deg]"
                >
                    <Icon name="twitter" size={iconSize} />
                </a>
            </div>
        </div>
    </div>
</section>
