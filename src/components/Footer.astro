---
import { Icon } from "astro-icon/components";
import Logo from "../../public/logo.svg";
import FooterBackground from "./FooterBackground";

const iconSize = 30;
---

<section class="relative w-full overflow-hidden bg-linear-to-b from-[#8E4E28] to-[#412717] px-6 py-12 flex justify-center">
    <div class="absolute inset-x-0 bottom-0 flex justify-center pointer-events-none z-0">
        <FooterBackground client:load />
    </div>

    <div class="relative z-10 flex flex-col md:flex-row justify-between items-start font-cowboy w-full gap-8 max-w-5xl">
        <div class="w-full md:w-1/3 flex flex-col justify-start items-start gap-y-4">
            <div class="w-28 md:w-36">
                <Logo />
            </div>
            <p class="text-white text-base tracking-widest">
                An Open House Event of FISIPOL UGM
            </p>
        </div>

        <div class="flex flex-col text-white text-xl gap-y-4 tracking-widest">
            <div>
                <a href="/ticket" class="hover:underline">
                    Tiket
                </a>
            </div>
            <div>
                <a href="/rundown" class="hover:underline">
                    Rundown
                </a>
            </div>
            <div>
                <a href="/gallery" class="hover:underline">
                    Galeri
                </a>
            </div>
            <div>
                <a href="/faq" class="hover:underline">
                    FAQ
                </a>
            </div>
        </div>

        <div class="flex flex-col w-full md:w-auto gap-y-4">
            <p class="text-white text-2xl tracking-widest">Stay in The Loop</p>
            <div class="w-full flex gap-x-6 text-white">
                <Icon name="instagram" size={iconSize} />
                <Icon name="tiktok" size={iconSize} />
                <Icon name="linkedin" size={iconSize} />
                <Icon name="twitter" size={iconSize} />
            </div>
        </div>
    </div>
</section>
