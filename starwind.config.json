{
  "$schema": "https://starwind.dev/config-schema.v2.json",
  "version": 2,
  "framework": "astro",
  "registry": {
    "source": "bundled",
    "version": "2.2.0"
  },
  "components": [
    {
      "name": "accordion",
      "version": "2.0.4",
      "framework": "react",
      "registry": "default"
    }
  ],
  "tailwind": {
    "css": "src/styles/starwind.css",
    "baseColor": "neutral",
    "cssVariables": true
  },
  "componentDir": "src/components/starwind",
  "componentDirs": {
    "react": "src/components/starwind-react"
  },
  "utilsDir": "src/lib/utils"
}
